# SwiftDrop Backend — Environment Variables
# Copy this file to .env and fill in real values before running.

DATABASE_URL=postgresql://swiftdrop:swiftdrop_pass@localhost:5432/swiftdrop
SECRET_KEY=replace_this_with_a_64_char_random_string_from_secrets_module
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
# Accepts a JSON array, a comma-separated list, or a single URL — so pasting
# "https://your-app.vercel.app" straight into a hosting dashboard works.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Connection pool ───────────────────────────────────────────────────────────
# asyncpg opens MIN_SIZE connections eagerly. Free-tier Postgres allows only a
# handful in total, so keep these small when deployed.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
