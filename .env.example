# SwiftDrop Backend — Environment Variables
# Copy this file to .env and fill in real values before running.

DATABASE_URL=postgresql://swiftdrop:swiftdrop_pass@localhost:5432/swiftdrop
SECRET_KEY=replace_this_with_a_64_char_random_string_from_secrets_module
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
